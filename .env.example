# Copy to .env. Local development only; do not commit credentials.
APP_MODE=sample
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# New demo accounts only. To reset an existing one: ./scripts/reset-password.ps1 -Username teacher
SEED_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgres://edu:edu-local-only@127.0.0.1:55432/edu?sslmode=disable
RUNTIME_DATABASE_URL=postgres://edu_app:edu-runtime-local-only@127.0.0.1:55432/edu?sslmode=disable
LISTEN_ADDR=127.0.0.1:8080
RENDER_SERVICE_URL=http://127.0.0.1:8000

# Ark text model endpoint. Do not put /contents/generations/tasks here.
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL=
# Independent reviewer; blank key disables review, never falls back to generation credentials.
EVAL_LLM_BASE_URL=https://api.deepseek.com
EVAL_LLM_API_KEY=
EVAL_LLM_MODEL=deepseek-flash
# Image-capable reviewer is required for new live planned courseware.
# Missing content/vision review configuration blocks creation before reservation.
# Animation keeps its separate optional keyframe review and teacher acceptance.
VISION_LLM_BASE_URL=
VISION_LLM_API_KEY=
VISION_LLM_MODEL=
# Optional independent text models (Chat Completions-compatible). Blank values use LLM_*.
COURSEWARE_LLM_BASE_URL=
COURSEWARE_LLM_API_KEY=
COURSEWARE_LLM_MODEL=
ANIMATION_LLM_BASE_URL=
ANIMATION_LLM_API_KEY=
ANIMATION_LLM_MODEL=
# Cloud video: dashscope, minimax or ark. DashScope/MiniMax require a separate key.
# DashScope: wan2.7-t2v, 2-15 seconds, 720P/16:9; use video /api/v1, NOT compatible-mode/v1.
# MiniMax-H3: 4-15 seconds; MiniMax-H3-Max: 5-15 seconds. Delivered at 768P, muted.
# Ark deployments may still use the legacy ARK_VIDEO_* keys; VIDEO_* takes priority.
VIDEO_PROVIDER=dashscope
VIDEO_BASE_URL=https://maas.qianwenaiapi.com/api/v1
VIDEO_API_KEY=
VIDEO_MODEL=wan2.7-t2v
VIDEO_DURATION=5
# Optional 1536-dimensional text embedding model; otherwise keyword retrieval.
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Tavily-compatible adapter; optional until a search provider/key is confirmed.
SEARCH_API_URL=https://api.tavily.com/search
SEARCH_API_KEY=
# Optional compatible rerank service. Leave blank to disable.
RERANK_URL=
RERANK_MODEL=
RERANK_API_KEY=
ANIMATION_IMAGE=edu-manim:local

# Optional cloud services; empty values preserve local files/pgvector mode.
# PostgreSQL must support pgvector; runtime role must remain NOBYPASSRLS.
# Tunnel requires work/cloud/id_ed25519 and pinned known_hosts.
CLOUD_SSH_HOST=
CLOUD_SSH_USER=root
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=edu-agent
MINIO_PREFIX=
REDIS_ADDR=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PREFIX=edu-agent:
MILVUS_URL=
MILVUS_TOKEN=
MILVUS_DATABASE=edu_agent
MILVUS_COLLECTION=edu_agent_chunks

# Explicitly pause courseware content-model review; visual checks and teacher approval remain.
COURSEWARE_CONTENT_REVIEW_DISABLED=false

# Teaching animation narration (new engine). Volcengine Doubao TTS, V3 HTTP Chunked unidirectional.
# Leave the key blank to keep live narration unconfigured; sample mode never calls TTS and is labelled "无真实语音".
# Keys go in .env only; they are sent server-side and never written to packages or logs.
ANIMATION_TTS_PROVIDER=volcengine
ANIMATION_TTS_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
ANIMATION_TTS_API_KEY=
# seed-tts-2.0 for Doubao TTS 2.0 voices; seed-icl-2.0 for cloned voices.
ANIMATION_TTS_RESOURCE_ID=seed-tts-2.0
# Fixed Mandarin female voice; lock after listening test (console > 音色).
ANIMATION_TTS_SPEAKER=
ANIMATION_TTS_FORMAT=mp3
ANIMATION_TTS_SAMPLE_RATE=24000
# -50..100, 0 = normal speed.
ANIMATION_TTS_SPEECH_RATE=0
# Synthesis unit, chosen once after the probe: sentence (only value implemented). No runtime fallback.
ANIMATION_TTS_UNIT=sentence
# Bounded retries per synthesis unit; exhausting them fails the work visibly.
ANIMATION_TTS_RETRIES=2
