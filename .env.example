# Copy to .env. Local development only; do not commit credentials.
APP_MODE=sample
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# New demo accounts only. To reset an existing one: ./scripts/reset-password.ps1 -Username teacher
SEED_PASSWORD=replace-with-a-local-password
# Set independently generated passwords. Provision once before first startup:
# cd backend-go; go run ../scripts/provision-database.go
POSTGRES_PASSWORD=replace-with-a-random-password-at-least-24-characters
DATABASE_URL=postgres://edu:replace-with-admin-password@127.0.0.1:55432/edu?sslmode=disable
RUNTIME_DATABASE_URL=postgres://edu_app:replace-with-runtime-password@127.0.0.1:55432/edu?sslmode=disable
LISTEN_ADDR=127.0.0.1:8080
RENDER_SERVICE_URL=http://127.0.0.1:8000

# Ark text model endpoint. Do not put /contents/generations/tasks here.
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL=
# Independent reviewer; blank key disables review, never falls back to generation credentials.
EVAL_LLM_BASE_URL=https://api.deepseek.com
EVAL_LLM_API_KEY=
EVAL_LLM_MODEL=deepseek-flash
# Image-capable reviewer is required for new live planned courseware.
# Missing content/vision review configuration blocks creation before reservation.
# HTML animation uses controlled rendering and explicit teacher acceptance.
VISION_LLM_BASE_URL=
VISION_LLM_API_KEY=
VISION_LLM_MODEL=
# Optional independent text models (Chat Completions-compatible). Blank values use LLM_*.
COURSEWARE_LLM_BASE_URL=
COURSEWARE_LLM_API_KEY=
COURSEWARE_LLM_MODEL=
# HTML animation requires all three explicitly; local setup may reuse EVAL_LLM_* values.
# For DeepSeek set URL=https://api.deepseek.com, its own key, MODEL=deepseek-flash together.
# No automatic cross-provider credential fallback in --anim-generate.
ANIMATION_LLM_BASE_URL=
ANIMATION_LLM_API_KEY=
ANIMATION_LLM_MODEL=
# Optional 1536-dimensional text embedding model; otherwise keyword retrieval.
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Tavily-compatible adapter; optional until a search provider/key is confirmed.
SEARCH_API_URL=https://api.tavily.com/search
SEARCH_API_KEY=
# Optional compatible rerank service. Leave blank to disable.
RERANK_URL=
RERANK_MODEL=
RERANK_API_KEY=

# Optional cloud services; empty values preserve local files/pgvector mode.
# PostgreSQL must support pgvector; runtime role must remain NOBYPASSRLS.
# Tunnel requires work/cloud/id_ed25519 and pinned known_hosts.
CLOUD_SSH_HOST=
CLOUD_SSH_USER=root
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=edu-agent
MINIO_PREFIX=
REDIS_ADDR=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PREFIX=edu-agent:
MILVUS_URL=
MILVUS_TOKEN=
MILVUS_DATABASE=edu_agent
MILVUS_COLLECTION=edu_agent_chunks

# Explicitly pause courseware content-model review; visual checks and teacher approval remain.
COURSEWARE_CONTENT_REVIEW_DISABLED=false
COURSEWARE_REVIEW_POLICY=key
# Sample mode keeps simulated purchases. Live mode requires this explicit opt-in.
ALLOW_SIMULATED_PAYMENT=false

# Teaching animation narration. Select one protocol explicitly; no runtime fallback.
# Leave the key blank to keep live narration unconfigured; sample mode never calls TTS and is labelled "无真实语音".
# Keys go in .env only; they are sent server-side and never written to packages or logs.
ANIMATION_TTS_PROVIDER=volcengine
# unidirectional: V3 streaming; create: Seed Audio nonstreaming /api/v3/tts/create.
ANIMATION_TTS_PROTOCOL=unidirectional
# Only used by create. Set URL to https://openspeech.bytedance.com/api/v3/tts/create
# and sample rate to 48000 to match the verified Seed Audio probe.
ANIMATION_TTS_MODEL=seed-audio-1.0
ANIMATION_TTS_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
ANIMATION_TTS_API_KEY=
# Streaming only: seed-tts-2.0 for TTS 2.0 voices; seed-icl-2.0 for cloned voices.
ANIMATION_TTS_RESOURCE_ID=seed-tts-2.0
# Streaming requires a speaker; create may omit it and use a Mandarin female voice prompt.
# A prompt does not lock identity across clips. A fixed speaker/reference still needs validation.
ANIMATION_TTS_SPEAKER=
ANIMATION_TTS_FORMAT=mp3
ANIMATION_TTS_SAMPLE_RATE=24000
# -50..100, 0 = normal speed.
ANIMATION_TTS_SPEECH_RATE=0
# Synthesis unit, chosen once after the probe: sentence (only value implemented). No runtime fallback.
ANIMATION_TTS_UNIT=sentence
# Bounded retries per synthesis unit; exhausting them fails the work visibly.
ANIMATION_TTS_RETRIES=2

# HTML workflow trial call caps per original request (retained across restarts/recovery).
# Independent counters; not extra member charges. No screenshot model in this slice.
ANIMATION_LIMIT_DISCUSSION=8
ANIMATION_LIMIT_JSON_REPAIR=4
ANIMATION_LIMIT_SCENE_REPAIR=10
ANIMATION_LIMIT_TTS=120
# The HTTP workflow checkpoints each sentence and uses explicit recovery;
# ANIMATION_TTS_RETRIES applies to CLI/probe retries, not a hidden workflow loop.

# Optional MP4 export: install animation-video dependencies first. Absolute path recommended.
ANIMATION_EXPORT_SCRIPT=
# Optional explicit trusted Office preview script; release startup sets this to its artifact.
COURSEWARE_PREVIEW_SCRIPT=
ANIMATION_NODE_PATH=node
ANIMATION_CHROME_PATH=
