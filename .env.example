# Copy to .env. Local development only; do not commit credentials.
APP_MODE=sample
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# New demo accounts only. To reset an existing one: ./scripts/reset-password.ps1 -Username teacher
SEED_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgres://edu:edu-local-only@127.0.0.1:55432/edu?sslmode=disable
RUNTIME_DATABASE_URL=postgres://edu_app:edu-runtime-local-only@127.0.0.1:55432/edu?sslmode=disable
LISTEN_ADDR=127.0.0.1:8080
RENDER_SERVICE_URL=http://127.0.0.1:8000

# Ark text model endpoint. Do not put /contents/generations/tasks here.
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL=
# Independent reviewer; blank key disables review, never falls back to generation credentials.
EVAL_LLM_BASE_URL=https://api.deepseek.com
EVAL_LLM_API_KEY=
EVAL_LLM_MODEL=deepseek-flash
# Optional independent image-capable reviewer; no key means explicit manual visual acceptance.
VISION_LLM_BASE_URL=
VISION_LLM_API_KEY=
VISION_LLM_MODEL=
# Optional independent text models (Chat Completions-compatible). Blank values use LLM_*.
COURSEWARE_LLM_BASE_URL=
COURSEWARE_LLM_API_KEY=
COURSEWARE_LLM_MODEL=
ANIMATION_LLM_BASE_URL=
ANIMATION_LLM_API_KEY=
ANIMATION_LLM_MODEL=
# Cloud video: dashscope, minimax or ark. DashScope/MiniMax require a separate key.
# DashScope: wan2.7-t2v, 2-15 seconds, 720P/16:9; use video /api/v1, NOT compatible-mode/v1.
# MiniMax-H3: 4-15 seconds; MiniMax-H3-Max: 5-15 seconds. Delivered at 768P, muted.
# Ark deployments may still use the legacy ARK_VIDEO_* keys; VIDEO_* takes priority.
VIDEO_PROVIDER=dashscope
VIDEO_BASE_URL=https://maas.qianwenaiapi.com/api/v1
VIDEO_API_KEY=
VIDEO_MODEL=wan2.7-t2v
VIDEO_DURATION=5
# Optional 1536-dimensional text embedding model; otherwise keyword retrieval.
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Tavily-compatible adapter; optional until a search provider/key is confirmed.
SEARCH_API_URL=https://api.tavily.com/search
SEARCH_API_KEY=
# Optional compatible rerank service. Leave blank to disable.
RERANK_URL=
RERANK_MODEL=
RERANK_API_KEY=
ANIMATION_IMAGE=edu-manim:local
